acf_keypaths = ["/ego_state/ego_state/F_x", "/ego_state/ego_state/T"]
fft_keypaths = ["/ego_state/ego_state/F_x", "/ego_state/ego_state/T"]
# acf_keypaths = ["/loadcells/forces/mono/back_left"]
# fft_keypaths = ["/loadcells/forces/mono/back_left"]
