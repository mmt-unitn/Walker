sub_topic = ["ego_state"] # Topics to subscribe to (array of strings)
time = ""       # Name of the timecode column in the input data (string)
# List of keypaths for time series
#keypaths = ["/loadcells/forces/triaxis_l/fx_l", "/loadcells/forces/triaxis_l/fy_l", "/loadcells/forces/triaxis_l/fz_l", "/loadcells/forces/triaxis_r/fx_r", "/loadcells/forces/triaxi>
