[odometry_filter]
type = "filter"
plugin = "odometry_filter.plugin"
###########################################################################################
#sub_topic = ["encoders_source", "imu_source", "pose_rs_source"] # 1st DataSet
sub_topic = ["encoders", "imu", "H_initial_walker_aruco", "H_initial_walker_htc"]
pub_topic = "group4"
###########################################################################################
#queue_size = 1
agent_id = "odometry_filter"
# Parametri numerici:
wheel_radius_left = 0.0873
wheel_radius_right = 0.0857
baseline = 0.8291
ticks_per_rev = 4096
sigma_p = 0.05
sigma_w = 0.05
sigma_enc_rot = 0.2
sigma_gyro = 0.002
sigma_rs_pos = 0.05
sigma_rs_ang = 0.05
sigma_acc = 0.065
alpha_a = 0.15
alpha_v = 0.10
filter_window_imu = 10
filter_window_enc = 10
# SENSOR FUSION DATA USES GLOBAL_ROTATION = 3.1415926, CAM_OFFSET_X = 0.775, CAM_OFFSET_Y = 0.0 2nd and 3rd dataset both have all 0 in these values
rs_global_rotation = 3.1415926   # Rotate Realsense pose by 180 degrees (in radians)
cam_offset_x = 0.775  
cam_offset_y = 0.0
#important param to check based on dataset, for 1st false, 2nd and 3rd true
############################################################################################
aruco_is_walker_center = true  #param to know if aruco is at walker center or camera center
############################################################################################
enable_slip_check = true
min_imu_accel_for_correction = 0.001
calibration_active = false  # PARAM TO ACTIVATE/DISACTIVATE CALIBRATION PROCEDURE
gyro_scaling = 1.005964613  # SCALING FACTOR FROM CALIBRATION PROCEDURE
htc = true  # PARAM TO ACTIVATE/DISACTIVATE HTC USAGE FOR ERROR ESTIMATION (ONLY FOR DATASETS WITH GROUND TRUTH)

[rerunner_group4]
sub_topic = ["group4"] # Topics to subscribe to (array of strings)
# List of keypaths for time series

[group5]
pub_topic = ["group5"]
sub_topic = ["imu", "encoders", "H_initial_walker_aruco"]


[challenge_group2]
pub_topic = "group2"
queue_size = 1
sub_topic = ["encoders", 
            "H_initial_walker_htc", 
            "H_initial_walker_aruco", 
            "imu"]
# robot parameters
R_L = 0.0876    # raggio ruota sinistra [m]
R_R = 0.0886    # raggio ruota destra [m]
n0 = 4096       # tics per giro
b = 0.8313      # distanza tra ruote [m]

# offsets of IMU computed with mean when rover is still
a_x_off_imu = 0.0240   # [g]
a_y_off_imu = 0.0267   # [g]
w_z_off_imu = 0.00048196  # [rad/s]


# Nel Kalman Filter, più il valore di rumore (R) è alto, meno il filtro si fida del sensore.
q_pos = 0.000001      # Incertezza modello encoder (metri)
q_yaw = 0.000001      # Incertezza modello rotazione (radianti)

r_rs_pos = 10.8       # Incertezza posizione Realsense (metri)     
r_rs_yaw = 10         # Incertezza angolo Realsense (radianti). 

r_imu_yaw = 200       # Incertezza sensore IMU (più è basso, più domina l'IMU)

[rerunner_group2]
#queue_size = 1
sub_topic = "group2"            # Topics to subscribe to (array of strings)
time = "/group2/timecode"       # Name of the timecode column in the input data
keypaths = ["/group2/position_enc/0", 
            "/group2/position_enc/1", 
            "/group2/position_enc/2", 
            "/group2/position_htc/0", 
            "/group2/position_htc/1", 
            "/group2/position_htc/2", 
            "/group2/position_realsense/0", 
            "/group2/position_realsense/1", 
            "/group2/position_realsense/2", 
            "/group2/position_imu/0", 
            "/group2/position_imu/1", 
            "/group2/position_imu/2", 
            "/group2/position_ekf/0", 
            "/group2/position_ekf/1", 
            "/group2/position_ekf/2"]
trace_keypaths = ["/group2/position_enc", 
                  "/group2/position_htc", 
                  "/group2/position_realsense", 
                  "/group2/position_imu", 
                  "/group2/position_ekf"]
blueprint = "/Users/alberto/MECHATRONIC_ENGINEERING/ROBOTIC_PERCEPTION/PROJECT/PLUGIN/rerunner_plugin/rerunner_pose_1.rbl"   

[kalman_filter]
sub_topic = ["imu","encoders","H_initial_walker_aruco"]
#sub_topic = ["imu","encoders","aruco","htc"]
#pub_topic = "kalman_estimate"
pub_topic = "group6"

[rt]
sub_topic=["rt_input"]
pub_topic="rt"
